# ================================
# NestJS IM Microservices - Environment Configuration (Development)
# ================================
# Copy this file to .env.dev and modify as needed:
# cp env.dev.example .env.dev

# MongoDB Configuration
MONGODB_USERNAME=admin
MONGODB_PASSWORD=admin_password
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=messageapp
MONGODB_AUTH_SOURCE=admin

# MongoDB Connection String (with Replica Set)
MONGODB_URI=mongodb://admin:admin_password@mongodb:27017/messageapp?authSource=admin&replicaSet=rs0

# JWT Secret (MUST change in production)
JWT_SECRET=your-secret-key-change-in-production

# Application Environment
NODE_ENV=development

# Microservice Ports (gRPC internal communication)
USER_SERVICE_PORT=50052
CHAT_SERVICE_PORT=50053
FILE_SERVICE_PORT=50055
NOTIFICATION_SERVICE_PORT=50056
RTC_SERVICE_PORT=50058
WEBSOCKET_SERVICE_PORT=3001

# Microservice URLs (Docker internal network)
USER_SERVICE_URL=user-service:50052
CHAT_SERVICE_URL=chat-service:50053
FILE_SERVICE_URL=file-service:50055
NOTIFICATION_SERVICE_URL=notification-service:50056
RTC_SERVICE_URL=rtc-service:50058
WEBSOCKET_SERVICE_URL=websocket-server:3001

# API Gateway
API_GATEWAY_PORT=3050
API_GATEWAY_URL=http://localhost:3050

# MongoDB External Port (for development tools)
MONGODB_EXTERNAL_PORT=27017

# System Settings
TZ=Asia/Taipei
GRPC_ONLY=true

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
# 容器內部連線（file-service → minio），不要改
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=messages-file
MINIO_SERVER_URL=http://minio:9000
# 本機對外 port（跟本機其他服務撞到時改這裡，MINIO_PUBLIC_ENDPOINT 要跟著改）
MINIO_EXTERNAL_PORT=9000
MINIO_CONSOLE_EXTERNAL_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_password

# Firebase FCM Configuration
FIREBASE_CONFIG_PATH=/app/keys/firebase-service-account.json

# Apple APNs Configuration
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APNS_TEAM_ID
APNS_BUNDLE_ID=com.example.imapp
APNS_KEY_PATH=/app/keys/apns-key.p8
APNS_PRODUCTION=false

# iOS 15+ Advanced Configuration
APNS_DEFAULT_INTERRUPTION_LEVEL=active
APNS_DEFAULT_RELEVANCE_SCORE=0.8
APNS_ENABLE_MUTABLE_CONTENT=true
APNS_NOTIFICATION_EXPIRATION=86400
APNS_VIP_INTERRUPTION_LEVEL=time-sensitive
APNS_VIP_RELEVANCE_SCORE=0.95
APNS_GROUP_INTERRUPTION_LEVEL=passive
APNS_GROUP_RELEVANCE_SCORE=0.6

# LiveKit Configuration
LIVEKIT_HOST=livekit-server
LIVEKIT_URL=ws://livekit-server:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-livekit-secret-change-in-production

# Coturn (STUN/TURN) Configuration
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpassword
TURN_REALM=localhost
