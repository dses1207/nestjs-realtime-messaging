
# ---- Builder Stage ----
FROM node:22 AS builder

# 設定時區
RUN apt-get update && apt-get install -y tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Taipei /etc/localtime \
    && echo "Asia/Taipei" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Taipei
# 安裝 pnpm
RUN npm install -g pnpm

WORKDIR /app

# 複製 package.json 與 lock file，避免版本不一致
COPY websocket-server/package.json pnpm-lock.yaml* ./

# 安裝完整依賴（含 devDependencies）
RUN pnpm install

# 複製原始碼和 proto
COPY websocket-server/. .
COPY protos ./protos

# 執行建置
RUN pnpm run build

# 設定 CI 環境變數，避免 pnpm prune 需要互動式確認
ENV CI=true

# 移除 devDependencies，只保留 production 依賴
RUN pnpm prune --prod
# ---- Runner Stage ----
FROM node:22-slim AS runner

# 設定時區
RUN apt-get update && apt-get install -y tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Taipei /etc/localtime \
    && echo "Asia/Taipei" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Taipei

# 同步代理設定（有需要時會生效）

WORKDIR /app

# 從 builder 階段複製必要檔案
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/protos ./protos
COPY websocket-server/package.json ./

# 生產環境啟動命令
CMD ["node", "dist/main"]